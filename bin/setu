#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const { spawn, execSync } = require('child_process');
const db = require('../lib/db');

const PID_FILE = path.join(__dirname, '../setu.pid');
const LOG_FILE = path.join(__dirname, '../setu.log');
const INDEX_SCRIPT = path.join(__dirname, '../index.js');

const cmd = process.argv[2];
const args = process.argv.slice(3);

function log(msg) {
  console.log(`[SETU] ${msg}`);
}

function getPid() {
  if (fs.existsSync(PID_FILE)) {
    return parseInt(fs.readFileSync(PID_FILE, 'utf8'));
  }
  return null;
}

function isRunning(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (e) {
    return false;
  }
}

switch (cmd) {
  case 'start':
    const pid = getPid();
    if (pid && isRunning(pid)) {
      log(`Already running (PID: ${pid})`);
    } else {
      log('Starting Setu Kernel...');
      const out = fs.openSync(LOG_FILE, 'a');
      const err = fs.openSync(LOG_FILE, 'a');

      const child = spawn('node', [INDEX_SCRIPT], {
        detached: true,
        stdio: ['ignore', out, err]
      });

      fs.writeFileSync(PID_FILE, child.pid.toString());
      child.unref();
      log(`Started! (PID: ${child.pid}) - Logs: setu.log`);
    }
    break;

  case 'stop':
    const stopPid = getPid();
    if (stopPid && isRunning(stopPid)) {
      log(`Stopping Setu (PID: ${stopPid})...`);
      process.kill(stopPid);
      fs.unlinkSync(PID_FILE);
      log('Stopped.');
    } else {
      log('Not running.');
      if (fs.existsSync(PID_FILE)) fs.unlinkSync(PID_FILE);
    }
    break;

  case 'status':
    const statusPid = getPid();
    const running = statusPid && isRunning(statusPid);
    console.log(`\n🌉 SETU STATUS: ${running ? '🟢 RUNNING' : '🔴 STOPPED'}`);
    if (running) console.log(`PID: ${statusPid}`);

    console.log('\n🤖 AGENTS:');
    try {
      const agents = db.db.prepare('SELECT * FROM agents').all();
      console.table(agents);
    } catch (e) {
      console.log('DB Error:', e.message);
    }
    break;

  case 'init':
    log('Initializing Project...');
    const contextPath = path.join(process.cwd(), 'CONTEXT.md');
    if (!fs.existsSync(contextPath)) {
      fs.writeFileSync(contextPath, '# Project Context\n\n');
      log('Created CONTEXT.md');
    } else {
      log('CONTEXT.md already exists.');
    }
    break;

  case 'chat':
    const message = args.join(' ');
    if (!message) {
      log('Usage: setu chat "Hello"');
    } else {
      db.send('User', 'Narad', message, 'chat');
      log(`Sent: "${message}"`);
    }
    break;

  case 'task':
    const { getOnboardingStatus } = require('../lib/onboarding/status');
    const taskStat = getOnboardingStatus({ fast: true }); // Fast caching to keep hard-gate blazing fast
    if (!taskStat.ok) {
      log('🛑 Hard Gate Failure: Onboarding Incomplete');
      log(`   Missing: ${taskStat.missing.join(', ')}`);
      taskStat.errors.forEach(e => log(`- ${e}`));
      log('\n🔧 TO FIX:');
      log('   Run: "setu onboarding run"');
      log('   Or:  "setu onboarding run --only-missing" (quick patch)');
      process.exit(1);
    }
    const [taskId, taskStatus, taskOwner] = args;
    if (!taskId || !taskStatus) {
      log('Usage: setu task <id> <status> [owner]');
    } else {
      db.updateTask(taskId, taskStatus, { owner: taskOwner || 'Unknown' });
      log(`Task ${taskId} -> ${taskStatus}`);
    }
    break;

    break;

  case 'doctor':
    log('⚠️ WARNING: "setu doctor" is deprecated. Please use "setu onboarding doctor" instead.');
    const doctorLegacy = require('child_process').spawn('node', [path.join(__dirname, '../agents/Vaidya.js')], { stdio: 'inherit' });
    doctorLegacy.on('exit', (code) => process.exit(code));
    break;

  case 'setup':
    require('child_process').spawn('node', [path.join(__dirname, 'setup.js')], { stdio: 'inherit' });
    break;

  case 'dashboard':
    const dashboardMode = args[0] || '--tui';
    const { spawn: dSpawn } = require('child_process');

    if (dashboardMode === '--gui' || dashboardMode === '--all') {
      log('Starting GUI Dashboard on http://localhost:3000...');
      dSpawn('node', [path.join(__dirname, '../lib/server.js')], { stdio: 'inherit' });
    }

    if (dashboardMode === '--tui' || dashboardMode === '--all') {
      log('Starting TUI Dashboard...');
      const tui = dSpawn('node', [path.join(__dirname, 'dashboard.js')], { stdio: 'inherit' });
      tui.on('exit', () => process.exit(0));
    }
    break;

  case 'governance':
    const govSub = args[0];
    const { getActiveProfile, setProfile, PRESETS } = require('../lib/onboarding/governance-profiles');

    if (govSub === 'profile') {
      const act = args[1];
      if (act === 'show') {
        const active = getActiveProfile();
        log(`🛡️ Active Governance Profile: ${active.name.toUpperCase()}`);
        console.log(JSON.stringify(active.config, null, 2));
      } else if (act === 'set') {
        const val = args[2];
        try {
          const fresh = setProfile(val);
          log(`✅ Governance Profile set to: ${fresh.name.toUpperCase()}`);
          console.log(`- Strict Diff: ${fresh.config.strict_diff ? 'ON' : 'OFF'}`);
          console.log(`- Ownership Mode: ${fresh.config.ownership_mode}`);
          console.log(`- Telemetry Retention: ${fresh.config.telemetry_days} days (max ${fresh.config.telemetry_max})`);
        } catch (e) {
          console.error(`🛑 ${e.message}`);
        }
      } else {
        log('Usage: setu governance profile <show|set <name>>');
        log(`Available presets: ${Object.keys(PRESETS).join(', ')}`);
      }
    } else {
      log('Usage: setu governance profile <...>');
    }
    process.exit(0);
    break;

  case 'ignite':
    log('🚀 IGNITING SETU MISSION CONTROL...');
    const ignite = spawn('node', [path.join(__dirname, '../scripts/ignite.js')], {
      cwd: process.cwd(),
      stdio: 'inherit'
    });
    ignite.on('exit', (code) => process.exit(code));
    break;

  case 'adopt':
  case 'init':
    log(`⚠️ WARNING: "setu ${cmd}" is deprecated. Please use "setu onboarding run" instead.`);
    const adoptLegacy = spawn('node', [path.join(__dirname, 'setu-init.js')], {
      cwd: process.cwd(),
      stdio: 'inherit'
    });
    adoptLegacy.on('exit', (code) => process.exit(code));
    break;

  case 'onboarding':
    const subCmd = args[0];
    if (subCmd === 'status') {
      const isTrend = args.includes('--trend');
      if (isTrend) {
        const logPath = path.join(process.cwd(), '.setu', 'onboarding-history.jsonl');
        const isJson = args.includes('--json');

        if (!fs.existsSync(logPath)) {
          if (isJson) console.log(JSON.stringify({ error: 'No history found' }));
          else log('   No history found. Run "setu onboarding status" first.');
          process.exit(0);
        }

        try {
          const lines = fs.readFileSync(logPath, 'utf8').split('\n').filter(Boolean);
          const allRuns = lines.map(l => {
            try { return JSON.parse(l); } catch (e) { return null; }
          }).filter(Boolean);

          if (isJson) {
            console.log(JSON.stringify({ total_runs: allRuns.length, runs: allRuns.slice(-20) }, null, 2));
            process.exit(0);
          }

          log('📈 Onboarding Completeness Trend (-20)');
          const recent = allRuns.slice(-20);
          recent.forEach(r => {
            const icon = r.completeness === 100 ? '✅' : '⚠️ ';
            const bar = '█'.repeat(Math.round(r.completeness / 5)).padEnd(20, '░');
            console.log(`   ${r.timestamp.split('T')[0]} | ${icon} | ${r.completeness}% [${bar}]`);
          });

        } catch (e) {
          if (isJson) console.log(JSON.stringify({ error: 'Parse Failed' }));
          else log('🛑 Failed to parse telemetry.');
        }
        process.exit(0);
      }

      const { getOnboardingStatus: getStat } = require('../lib/onboarding/status');
      const isFast = args.includes('--fast');
      const stat = getStat({ fast: isFast }); // Strict by default unless --fast requested

      // Auto-trigger telemetry logging workflow via child_process for accurate stats updates
      const { spawnSync } = require('child_process');
      spawnSync('node', [path.join(__dirname, '../scripts/onboarding-status.js')]);

      if (!stat.ok) {
        log('🛑 Onboarding Incomplete');
        log(`Completeness: ${stat.completeness}%`);
        if (stat.stale) log('⚠️ Status is STALE (head_commit mismatch)');
        log(`Missing (${stat.missing.length}): ${stat.missing.join(', ')}`);
        stat.errors.forEach(e => log(`- ${e}`));
        log('\n🔧 TO FIX:');
        log('   Run: "setu onboarding run"');
        log('   Or:  "setu onboarding run --only-missing" (quick patch)');
        process.exit(1);
      } else {
        log('✅ Onboarding Complete (100%)');
        process.exit(0);
      }
    } else if (subCmd === 'run') {
      const { runGenerator } = require('../lib/onboarding/generator');
      const dryRun = args.includes('--dry-run');
      const onlyMissing = args.includes('--only-missing');

      runGenerator({ dryRun, onlyMissing });
      process.exit(0);
    } else if (subCmd === 'doctor') {
      const isTrend = args.includes('--trend');
      if (isTrend) {
        const logPath = path.join(process.cwd(), '.setu', 'drift-history.jsonl');
        const isJson = args.includes('--json');

        if (!fs.existsSync(logPath)) {
          if (isJson) {
            console.log(JSON.stringify({ error: 'No history found' }));
          } else {
            console.log('   No history found. Run "setu onboarding doctor --diff" first.');
          }
          process.exit(0);
        }

        try {
          const lines = fs.readFileSync(logPath, 'utf8').split('\n').filter(Boolean);
          const allRuns = lines.map(l => {
            try { return JSON.parse(l); } catch (e) { return null; }
          }).filter(Boolean);

          const last50 = allRuns.slice(-50);
          const last20 = allRuns.slice(-20);

          const getFailRate = (runs) => runs.length ? ((runs.filter(r => !r.ok).length / runs.length) * 100).toFixed(1) : 0;
          const failRate50 = getFailRate(last50);
          const failRate20 = getFailRate(last20);

          let sumDrift = 0;
          let drifts = [];

          // Source tracking
          const sources = { github_api: 0, git_diff: 0, head_fallback: 0 };
          const missingFreq = {};

          allRuns.forEach(r => {
            sumDrift += r.drift_percent;
            drifts.push(r.drift_percent);

            if (r.source) {
              sources[r.source] = (sources[r.source] || 0) + 1;
            }
            if (r.missing_docs && Array.isArray(r.missing_docs)) {
              r.missing_docs.forEach(doc => {
                missingFreq[doc] = (missingFreq[doc] || 0) + 1;
              });
            }
          });

          const avgDrift = allRuns.length ? (sumDrift / allRuns.length).toFixed(1) : 0;
          drifts.sort((a, b) => a - b);
          const p95Index = Math.floor(drifts.length * 0.95);
          const p95Drift = drifts.length ? drifts[p95Index] : 0;

          const topMissing = Object.entries(missingFreq)
            .sort((a, b) => b[1] - a[1])
            .slice(0, 10);

          if (isJson) {
            console.log(JSON.stringify({
              total_runs: allRuns.length,
              fail_rate_last_20: parseFloat(failRate20),
              fail_rate_last_50: parseFloat(failRate50),
              avg_drift_percent: parseFloat(avgDrift),
              p95_drift_percent: parseFloat(p95Drift),
              sources,
              top_missing_docs: topMissing.map(([doc, freq]) => ({ doc, freq }))
            }, null, 2));
            process.exit(0);
          }

          log('📈 Docs Drift Telemetry Trend');
          console.log(`   Total Runs Checked: ${allRuns.length}`);
          console.log(`   Rolling Fail Rate: ${failRate20}% (last 20) | ${failRate50}% (last 50)`);
          console.log(`   Drift Percent: ${avgDrift}% (Avg) | ${p95Drift}% (p95)`);

          console.log('\n   Source Reliability Split:');
          Object.entries(sources).forEach(([src, count]) => {
            const perc = ((count / allRuns.length) * 100).toFixed(1);
            console.log(`   - ${src}: ${count} runs (${perc}%)`);
          });

          if (topMissing.length > 0) {
            console.log('\n   Top 10 Missing Docs Frequency:');
            topMissing.forEach(([doc, freq]) => {
              console.log(`   - [${freq}x] ${doc}`);
            });
          }

          console.log('\n   Recent Executions:');
          last20.slice(-5).reverse().forEach(r => {
            const icon = r.ok ? '✅ ' : '🛑 ';
            console.log(`   ${r.timestamp} | ${icon} | Drift: ${r.drift_percent}% | Source: ${r.source}`);
          });

        } catch (e) {
          if (isJson) {
            console.log(JSON.stringify({ error: 'Failed to parse telemetry' }));
          } else {
            console.log('🛑 Failed to parse telemetry.');
          }
        }
        process.exit(0);
      }

      const isAutofix = args.includes('--autofix-plan');
      if (isAutofix) {
        const { computeDrift } = require('../lib/onboarding/drift');
        const result = computeDrift({ strict: true });
        const commands = [
          "setu onboarding run --only-missing",
          "setu onboarding doctor --diff --strict-diff"
        ];

        const payload = {
          missing_paths: result.missing_docs,
          commands_to_run: commands
        };

        const outPath = path.join(process.cwd(), '.setu', 'autofix-plan.json');
        if (!fs.existsSync(path.dirname(outPath))) fs.mkdirSync(path.dirname(outPath), { recursive: true });
        fs.writeFileSync(outPath, JSON.stringify(payload, null, 2));

        if (args.includes('--json')) {
          console.log(JSON.stringify(payload, null, 2));
        } else {
          log('🛠️ AUTOFIX PLAN GENERATED');
          console.log(`   Saved to: ${outPath}`);
          console.log(`\n   Execute the following to remediate (${result.missing_docs.length} missing):`);
          commands.forEach(c => console.log(`   > ${c}`));
        }
        process.exit(0);
      }

      const isDigest = args.includes('--digest-weekly');
      if (isDigest) {
        const logPath = path.join(process.cwd(), '.setu', 'drift-history.jsonl');
        const isJson = args.includes('--json');

        if (!fs.existsSync(logPath)) {
          if (isJson) console.log(JSON.stringify({ error: 'No history found' }));
          else log('   No history found. Run "setu onboarding doctor --diff" first.');
          process.exit(0);
        }

        try {
          const lines = fs.readFileSync(logPath, 'utf8').split('\n').filter(Boolean);
          const allRuns = lines.map(l => {
            try { return JSON.parse(l); } catch (e) { return null; }
          }).filter(Boolean);

          const now = new Date().getTime();
          const weekMs = 7 * 24 * 60 * 60 * 1000;
          const weekRuns = allRuns.filter(r => (now - new Date(r.timestamp).getTime()) <= weekMs);

          const failCount = weekRuns.filter(r => !r.ok).length;
          const failRate = weekRuns.length > 0 ? ((failCount / weekRuns.length) * 100).toFixed(1) : 0;
          let sumDrift = 0, drifts = [];
          const sources = { github_api: 0, git_diff: 0, head_fallback: 0 };
          const missingFreq = {}, unownedFreq = {};

          weekRuns.forEach(r => {
            sumDrift += r.drift_percent;
            drifts.push(r.drift_percent);
            if (r.source) sources[r.source] = (sources[r.source] || 0) + 1;
            if (r.missing_docs) r.missing_docs.forEach(d => missingFreq[d] = (missingFreq[d] || 0) + 1);
            if (r.ownership && r.ownership.unowned_files) {
              r.ownership.unowned_files.forEach(f => unownedFreq[f] = (unownedFreq[f] || 0) + 1);
            }
          });

          drifts.sort((a, b) => a - b);
          const p95Drift = drifts.length ? drifts[Math.floor(drifts.length * 0.95)] : 0;
          const avgDrift = weekRuns.length ? (sumDrift / weekRuns.length).toFixed(1) : 0;
          const topMissing = Object.entries(missingFreq).sort((a, b) => b[1] - a[1]).slice(0, 3).map(x => x[0]);
          const topUnowned = Object.entries(unownedFreq).sort((a, b) => b[1] - a[1]).slice(0, 3).map(x => x[0]);

          const payload = {
            period: '7d',
            total_runs: weekRuns.length,
            fail_rate: parseFloat(failRate),
            avg_drift: parseFloat(avgDrift),
            p95_drift: parseFloat(p95Drift),
            sources,
            top_missing_docs: topMissing,
            top_unowned_files: topUnowned,
            recommended_actions: [
              'Run "setu onboarding run --only-missing"',
              topUnowned.length > 0 ? `Update ONBOARDING.json for unowned paths (e.g. ${topUnowned[0]})` : 'Maintain 100% ownership mapping',
              'Review .setu/governance-profile.json policy scaling constraints'
            ]
          };

          if (isJson) {
            console.log(JSON.stringify(payload, null, 2));
          } else {
            log('📊 WEEKLY GOVERNANCE DIGEST (-7d)');
            console.log(`   Runs: ${payload.total_runs} | Fail Rate: ${payload.fail_rate}%`);
            console.log(`   Drift: ${payload.avg_drift}% (Avg) | ${payload.p95_drift}% (P95)`);
            console.log('\n   🔥 Top Unowned Files:');
            payload.top_unowned_files.length ? payload.top_unowned_files.forEach(f => console.log(`     - ${f}`)) : console.log('     [None]');
            console.log('\n   🔥 Top Missing Docs:');
            payload.top_missing_docs.length ? payload.top_missing_docs.forEach(f => console.log(`     - ${f}`)) : console.log('     [None]');
            console.log('\n   💡 Recommended Actions:');
            payload.recommended_actions.forEach((a, i) => console.log(`     ${i + 1}. ${a}`));
          }
        } catch (e) {
          if (isJson) console.log(JSON.stringify({ error: e.message }));
          else console.log('🛑 Failed to parse digest.');
        }
        process.exit(0);
      }

      const isDiff = args.includes('--diff');
      if (isDiff) {
        let baseRefConfig = undefined;
        const baseIndex = args.indexOf('--base');
        if (baseIndex !== -1 && args[baseIndex + 1]) {
          baseRefConfig = args[baseIndex + 1];
        }

        const isStrict = args.includes('--strict-diff');

        const { computeDrift } = require('../lib/onboarding/drift');
        const result = computeDrift({ base: baseRefConfig, strict: isStrict });

        const isJson = args.includes('--json');
        const showIgnored = args.includes('--show-ignored');

        if (isJson) {
          console.log(JSON.stringify(result, null, 2));
          process.exit(result.ok ? 0 : 1);
        }

        if (result.strict_diff_warning) {
          if (result.strict_diff_failed) {
            console.log(`\n🛑 STRICT DIFF CHECK FAILED:`);
            console.log(`   ${result.strict_diff_warning}`);
            process.exit(1);
          } else {
            console.log(`\n⚠️  WARNING [Strict-Diff Mode OFF]:`);
            console.log(`   ${result.strict_diff_warning}`);
          }
        }

        if (result.ok) {
          log(`✅ No drift detected (Checked ${result.changed_files.length} changed files against ${result.base_ref_used})`);
          if (showIgnored && result.ignored_files.length > 0) {
            console.log('\n🙈 Ignored Files:');
            result.ignored_files.forEach(f => console.log(`   - ${f}`));
          }
          process.exit(0);
        } else {
          if (result.ownership_sla && result.ownership_sla.unowned_blocking) {
            log(`🛑 Ownership SLA Failed!`);
            log(`   ${result.ownership_sla.blocking_files.length} unowned files matched required paths.`);
          } else if (result.drift_percent > 0) {
            log(`🛑 Docs Drift Detected: ${result.drift_percent}%`);
            log(`   ${result.changed_files.length} changed files require ${result.required_docs.length} doc updates; ${result.missing_docs.length} missing.\n`);
          }
          log(`   Comparison base: ${result.base_ref_used} (via ${result.changed_files_source})`);

          const missingFiles = result.missing_docs.filter(d => d.includes('/files/'));
          const missingFolders = result.missing_docs.filter(d => d.includes('/folders/'));

          if (missingFiles.length) {
            console.log('\n📄 Missing File Docs:');
            missingFiles.forEach(f => console.log(`   - ${f}`));
          }
          if (missingFolders.length) {
            console.log('\n📁 Missing Folder Summaries:');
            missingFolders.forEach(f => console.log(`   - ${f}`));
          }

          if (showIgnored && result.ignored_files.length > 0) {
            console.log('\n🙈 Ignored Files:');
            result.ignored_files.forEach(f => console.log(`   - ${f}`));
          }

          const ownerSourceTitle = result.ownership.ownership_source === 'onboarding' ? 'ONBOARDING' :
            (result.ownership.ownership_source === 'codeowners' ? 'CODEOWNERS fallback' : 'None');
          console.log(`\n👥 Suggested Reviewers/Owners (${ownerSourceTitle}):`);
          const owners = Object.keys(result.ownership.by_owner);
          if (owners.length > 0) {
            owners.forEach(owner => {
              console.log(`   - @${owner} (${result.ownership.by_owner[owner].length} files touched)`);
            });
          } else {
            console.log(`   (No owners identified limits)`);
          }

          if (result.ownership.unowned_files && result.ownership.unowned_files.length > 0) {
            console.log('\n⚠️  WARNING: Unowned Files Detected');
            console.log(`   ${result.ownership.unowned_files.length} changed files have no designated module owner.`);
            console.log('   Please assign them so drift routing hints operate smoothly.');
          }

          const isOwnersDebug = args.includes('--owners-debug');
          if (isOwnersDebug && result.ownership.ownership_resolution_trace) {
            console.log('\n🔍 OWNERSHIP RESOLUTION TRACE:');
            for (const [file, info] of Object.entries(result.ownership.ownership_resolution_trace)) {
              const ownersText = info.owners.length > 0 ? info.owners.join(', ') : 'Unowned';
              console.log(`   ${file}`);
              console.log(`     -> Source: ${info.source}`);
              console.log(`     -> Rule: ${info.rule}`);
              console.log(`     -> Owners: ${ownersText}`);
            }
          }

          console.log('\n🔧 TO FIX:');
          console.log('   Run: "setu onboarding run --only-missing"');
          console.log('   Then rerun: "setu onboarding doctor --diff"');
          process.exit(1);
        }
      } else {
        const doc = spawn('node', [path.join(__dirname, '../agents/Vaidya.js')], { stdio: 'inherit' });
        doc.on('exit', (code) => process.exit(code));
      }
    } else {
      log('Usage: setu onboarding [run|status|doctor] [--dry-run] [--only-missing]');
    }
    break;

  default:
    console.log('Usage: setu [start|stop|status|onboarding|chat|task|dashboard|ignite]');
}
