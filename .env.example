# Setu Configuration Template

# --- LLM Configuration (Dual Model Support) ---

# 1. Primary / Expensive Model (for reasoning, planning, coding)
# Providers: openai, anthropic, ollama, openai-compatible
MODEL_EXPENSIVE_PROVIDER=openai
MODEL_EXPENSIVE_NAME=gpt-4o
MODEL_EXPENSIVE_API_KEY=sk-...
# MODEL_EXPENSIVE_BASE_URL=https://api.openai.com/v1

# 2. Secondary / Cheap Model (for simple tasks, summaries)
# Can be same as expensive or different (e.g., local ollama)
MODEL_CHEAP_PROVIDER=openai
MODEL_CHEAP_NAME=gpt-3.5-turbo
MODEL_CHEAP_API_KEY=sk-...
# MODEL_CHEAP_BASE_URL=https://api.openai.com/v1

# --- Legacy/Fallback (Optional) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434

# --- Google OAuth Configuration ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Docker Configuration ---
# Path to docker executable (leave empty to auto-detect)
DOCKER_PATH=

# --- System ---
LOG_LEVEL=info
